# Copie para .env (cp .env.example .env). Valores fictícios, apenas para ambiente local.

# Banco de dados (container "db")
POSTGRES_USER=ascii
POSTGRES_PASSWORD=ascii_local
POSTGRES_DB=orcamentos

# Backend (container "backend")
PORT=3000
DATABASE_URL=postgresql://ascii:ascii_local@db:5432/orcamentos?schema=public
